# ---------------------------------------------------------------------------
# UKAF environment configuration
# Copy to .env.local (dev) or set in your host's dashboard (production).
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://ukaf:password@localhost:5432/ukaf?schema=public"

# Public site URL (no trailing slash) - used for links in emails and Stripe redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 64-char hex secret used to derive session/CSRF hashes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` in dev, or the endpoint signing secret in the dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend -------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="UKAF Commercials <sales@ukaf.co.uk>"
EMAIL_REPLY_TO="sales@ukaf.co.uk"
# Internal notifications (new enquiries, orders). Comma-separated.
SALES_NOTIFICATION_EMAILS="sales@ukaf.co.uk"

# Commerce -----------------------------------------------------------------
BASE_CURRENCY="GBP"
NEXT_PUBLIC_BASE_CURRENCY="GBP"

# Optional: automatic FX refresh (exchangerate.host / openexchangerates style)
FX_API_URL=""
FX_API_KEY=""
# Shared secret for POST /api/cron/* jobs
CRON_SECRET=""

# Bootstrap admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ukaf.co.uk"
SEED_ADMIN_PASSWORD="ChangeMe!2024"

# Company details shown in the footer, invoices and legal pages
NEXT_PUBLIC_COMPANY_NAME="UKAF Commercials Ltd"
NEXT_PUBLIC_COMPANY_NUMBER="09876543"
NEXT_PUBLIC_VAT_NUMBER="GB123456789"
NEXT_PUBLIC_COMPANY_ADDRESS="Unit 4, Trafford Park, Manchester, M17 1AB"
NEXT_PUBLIC_COMPANY_PHONE="+44 161 000 0000"
NEXT_PUBLIC_COMPANY_EMAIL="sales@ukaf.co.uk"
